---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import TrustedBy from '../components/TrustedBy.astro';

const services = [
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>',
    title: 'Desarrollo Web',
    description: 'Sitios y plataformas web modernas, rápidas y escalables.',
  },
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="20" x="5" y="2" rx="2"/><path d="M12 18h.01"/></svg>',
    title: 'Apps Móviles',
    description: 'Aplicaciones iOS y Android nativas o cross-platform.',
  },
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v8m0 0l-4 4m4-4l4 4"/><circle cx="12" cy="2" r="2" fill="currentColor"/><circle cx="8" cy="14" r="2" fill="currentColor"/><circle cx="16" cy="14" r="2" fill="currentColor"/></svg>',
    title: 'Sistemas a Medida',
    description: 'ERPs, CRMs y plataformas internas hechas a tu medida.',
  },
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>',
    title: 'Integraciones & APIs',
    description: 'Conectamos tus herramientas y automatizamos procesos.',
  },
];
---

<BaseLayout>
  <!-- HERO -->
  <section class="relative pt-32 pb-20 md:pt-44 md:pb-28 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">

      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white leading-[1.1] max-w-4xl mx-auto">
        <!-- Línea 1: animada palabra por palabra con SplitText -->
        <span id="hero-line-1" class="block">
          Construimos el software
        </span>

        <!-- Línea 2: animada como bloque (sin SplitText) -->
        <span
          id="hero-line-2"
          class="block bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-400 bg-clip-text text-transparent glow-text"
        >
          que tu negocio necesita.
        </span>
      </h1>

      <p id="hero-subtitle" class="mt-6 text-lg sm:text-xl text-slate-400 max-w-2xl mx-auto leading-relaxed">
        En TreeNode diseñamos, desarrollamos y escalamos sistemas a medida para empresas que quieren crecer sin límites técnicos.
      </p>

      <div id="hero-buttons" class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/contacto" class="w-full sm:w-auto px-8 py-4 rounded-xl text-sm font-bold bg-gradient-to-r from-emerald-500 to-teal-500 text-slate-950 hover:shadow-[0_0_30px_rgba(16,185,129,0.5)] transition-all">
          Empezar un proyecto →
        </a>
        <a href="/servicios" class="w-full sm:w-auto px-8 py-4 rounded-xl text-sm font-bold bg-slate-900/80 border border-slate-700 text-slate-200 hover:bg-slate-800 transition-all">
          Ver servicios
        </a>
      </div>

    </div>
  </section>

  <!-- CONFÍAN EN NOSOTROS -->
  <TrustedBy />

  <!-- SERVICIOS DESTACADOS -->
  <section class="py-24 bg-slate-950/60 border-y border-slate-800/60">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 id="services-eyebrow" class="text-xs font-mono font-bold tracking-widest text-emerald-400 uppercase mb-3">[ QUÉ HACEMOS ]</h2>
        <h3 id="services-title" class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">Servicios pensados para escalar.</h3>
        <p id="services-subtitle" class="mt-4 text-slate-400 text-base sm:text-lg">Soluciones tecnológicas end-to-end, desde la idea hasta producción.</p>
      </div>

      <div id="services-grid" class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {services.map((s) => <ServiceCard {...s} />)}
      </div>

      <div id="services-cta" class="text-center mt-12">
        <a href="/servicios" class="inline-flex items-center gap-2 text-emerald-400 hover:text-emerald-300 font-mono text-sm">
          Ver todos los servicios →
        </a>
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="py-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 id="cta-title" class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
        ¿Listo para construir algo grande?
      </h2>
      <p id="cta-subtitle" class="mt-4 text-slate-400 text-lg">Contanos tu idea y te ayudamos a hacerla realidad.</p>
      <a id="cta-button" href="/contacto" class="inline-block mt-8 px-8 py-4 rounded-xl text-sm font-bold bg-gradient-to-r from-emerald-500 to-teal-500 text-slate-950 hover:shadow-[0_0_30px_rgba(16,185,129,0.5)] transition-all">
        Hablemos →
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { SplitText } from "gsap/SplitText";

  gsap.registerPlugin(ScrollTrigger, SplitText);

  // ============================================
  // 1. SPLIT TEXT SOLO EN LA LÍNEA 1 DEL HERO
  // ============================================
  const splitLine1 = new SplitText("#hero-line-1", {
    type: "words",
  });

  const splitSubtitle = new SplitText("#hero-subtitle", {
    type: "lines",
    linesClass: "overflow-hidden",
  });

  // ============================================
  // 2. TIMELINE DE ENTRADA DEL HERO
  // ============================================
  const tl = gsap.timeline({ defaults: { ease: "power4.out" } });

  tl.from(splitLine1.words, {
    y: 80,
    opacity: 0,
    duration: 1,
    stagger: 0.06,
  })
    .from("#hero-line-2", {
      y: 40,
      opacity: 0,
      duration: 0.9,
    }, "-=0.5")
    .from(splitSubtitle.lines, {
      y: 40,
      opacity: 0,
      duration: 0.8,
      stagger: 0.1,
    }, "-=0.6")
    .from("#hero-buttons", {
      y: 20,
      opacity: 0,
      duration: 0.6,
    }, "-=0.4");

  // ============================================
  // 3. SECCIÓN SERVICIOS
  // ============================================
  const servicesTl = gsap.timeline({
    scrollTrigger: {
      trigger: "#services-title",
      start: "top 85%",
      toggleActions: "play none none none",
    },
    defaults: { ease: "power3.out" },
  });

  servicesTl
    .from("#services-eyebrow", { y: 20, opacity: 0, duration: 0.6 })
    .from("#services-title", { y: 40, opacity: 0, duration: 0.9 }, "-=0.4")
    .from("#services-subtitle", { y: 30, opacity: 0, duration: 0.7 }, "-=0.5")
    .from("#services-grid > *", { y: 60, opacity: 0, duration: 0.7, stagger: 0.12 }, "-=0.3")
    .from("#services-cta", { y: 20, opacity: 0, duration: 0.5 }, "-=0.3");

  // ============================================
  // 4. CTA FINAL
  // ============================================
  const ctaTl = gsap.timeline({
    scrollTrigger: {
      trigger: "#cta-title",
      start: "top 85%",
      toggleActions: "play none none none",
    },
    defaults: { ease: "power3.out" },
  });

  ctaTl
    .from("#cta-title", { y: 50, opacity: 0, duration: 1 })
    .from("#cta-subtitle", { y: 30, opacity: 0, duration: 0.7 }, "-=0.6")
    .from("#cta-button", { y: 20, opacity: 0, scale: 0.95, duration: 0.6 }, "-=0.4");
</script>