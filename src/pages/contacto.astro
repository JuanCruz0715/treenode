---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contacto | TreeNode" description="Hablemos de tu proyecto.">
  <section class="pt-32 pb-24 md:pt-44 md:pb-32">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-12 gap-12">
        <!-- Info -->
        <div class="lg:col-span-5 space-y-6">
          <span class="text-xs font-mono font-bold text-emerald-400 uppercase tracking-widest">[ CONTACTO ]</span>
          <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
            Hablemos de<br />tu proyecto.
          </h1>
          <p class="text-slate-400 text-sm sm:text-base leading-relaxed">
            Contanos qué tenés en mente y te respondemos en menos de 24hs con los próximos pasos.
          </p>

          <div class="space-y-4 pt-6">
            <div class="flex items-center gap-4 text-slate-300 text-sm font-mono">
              <div class="w-10 h-10 rounded-xl bg-slate-900 border border-slate-800 flex items-center justify-center text-emerald-400">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              </div>
              <span>hola@treenode.io</span>
            </div>
            <div class="flex items-center gap-4 text-slate-300 text-sm font-mono">
              <div class="w-10 h-10 rounded-xl bg-slate-900 border border-slate-800 flex items-center justify-center text-emerald-400">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              </div>
              <span>Remoto · Global</span>
            </div>
          </div>
        </div>

        <!-- Form -->
        <div class="lg:col-span-7">
          <form id="contactForm" class="glass-panel p-8 sm:p-10 rounded-3xl border border-slate-800 space-y-6">
            <div class="grid sm:grid-cols-2 gap-6">
              <div>
                <label class="block text-xs font-mono text-slate-300 uppercase mb-2">Nombre *</label>
                <input type="text" required placeholder="Tu nombre" class="w-full bg-slate-900 border border-slate-800 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-emerald-400 transition-colors" />
              </div>
              <div>
                <label class="block text-xs font-mono text-slate-300 uppercase mb-2">Email *</label>
                <input type="email" required placeholder="tu@email.com" class="w-full bg-slate-900 border border-slate-800 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-emerald-400 transition-colors" />
              </div>
            </div>

            <div>
              <label class="block text-xs font-mono text-slate-300 uppercase mb-2">Empresa</label>
              <input type="text" placeholder="Nombre de tu empresa" class="w-full bg-slate-900 border border-slate-800 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-emerald-400 transition-colors" />
            </div>

            <div>
              <label class="block text-xs font-mono text-slate-300 uppercase mb-2">Contanos tu proyecto *</label>
              <textarea rows="5" required placeholder="¿Qué querés construir? ¿Qué problema resolvés?" class="w-full bg-slate-900 border border-slate-800 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-emerald-400 transition-colors"></textarea>
            </div>

            <button type="submit" class="w-full py-4 rounded-xl font-mono font-bold text-xs uppercase tracking-wider bg-gradient-to-r from-emerald-500 to-teal-500 text-slate-950 hover:shadow-[0_0_25px_rgba(16,185,129,0.4)] transition-all">
              Enviar mensaje →
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Toast -->
  <div id="toast" class="fixed bottom-6 right-6 z-50 transform translate-y-24 opacity-0 transition-all duration-300 glass-panel px-6 py-4 rounded-2xl border border-emerald-500/40 text-emerald-300 flex items-center gap-3 shadow-2xl">
    <span class="text-sm font-mono">¡Mensaje enviado! Te contactamos pronto.</span>
  </div>

  <script>
    const form = document.getElementById('contactForm');
    const toast = document.getElementById('toast');
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      toast?.classList.remove('translate-y-24', 'opacity-0');
      setTimeout(() => toast?.classList.add('translate-y-24', 'opacity-0'), 4000);
      (form as HTMLFormElement).reset();
    });
  </script>
</BaseLayout>