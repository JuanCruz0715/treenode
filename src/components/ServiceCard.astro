---
interface Props {
  icon: string;
  title: string;
  description: string;
}
const { icon, title, description } = Astro.props;
---

<div class="glass-card p-8 rounded-2xl group">
  <div class="w-12 h-12 rounded-xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 mb-6 group-hover:bg-emerald-500 group-hover:text-slate-950 transition-colors">
    <span set:html={icon} />
  </div>
  <h4 class="text-xl font-bold text-white mb-3">{title}</h4>
  <p class="text-slate-400 text-sm leading-relaxed">{description}</p>
</div>