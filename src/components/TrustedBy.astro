---
interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = 'Empresas que confían en nosotros',
  subtitle = 'Trabajamos con startups y empresas que necesitan software a medida.',
} = Astro.props;

// Reemplazá estos por tus clientes reales.
// Cada uno tiene: name (para accesibilidad) y logo (ruta en /public/logos/)
const clients = [
  { name: 'Cliente 1', logo: '/logos/client-1.svg' },
  { name: 'Cliente 2', logo: '/logos/client-2.svg' },
  { name: 'Cliente 3', logo: '/logos/client-3.svg' },
  { name: 'Cliente 4', logo: '/logos/client-4.svg' },
  { name: 'Cliente 5', logo: '/logos/client-5.svg' },
  { name: 'Cliente 6', logo: '/logos/client-6.svg' },
];
---

<section class="py-20 relative z-10 border-y border-slate-800/60 bg-slate-950/40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <h2 class="text-xs font-mono font-bold tracking-widest text-emerald-400 uppercase mb-3">
        [ CONFÍAN EN NOSOTROS ]
      </h2>
      <h3 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
        {title}
      </h3>
      <p class="mt-3 text-slate-400 text-sm sm:text-base">
        {subtitle}
      </p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-6 items-center">
      {clients.map((client) => (
        <div class="group flex items-center justify-center p-6 rounded-2xl bg-slate-900/40 border border-slate-800/60 hover:border-emerald-500/30 transition-all duration-300">
          <img
            src={client.logo}
            alt={client.name}
            class="h-8 sm:h-10 w-auto opacity-50 grayscale group-hover:opacity-100 group-hover:grayscale-0 transition-all duration-300"
          />
        </div>
      ))}
    </div>
  </div>
</section>