---
interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = 'Empresas que confían en nosotros',
  subtitle = 'Trabajamos con startups y empresas que necesitan software a medida.',
} = Astro.props;

const clients = [
  { 
    name: 'SN', 
    logo: '/sn.png', 
    project: 'Sistema Integral de Gestión de Viajes',
    problem: 'Centralizamos la facturación, la gestión de pasajeros y la administración de viajes en una sola plataforma. Eliminamos las planillas manuales, reduciendo errores y agilizando la operación diaria.',
    tech: 'Node.js · PostgreSQL · React'
  },
  // Acá podés agregar más clientes en el futuro siguiendo el mismo formato.
];
---

<section class="py-20 relative z-10 border-y border-slate-800/60 bg-slate-950/40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <h2 class="text-xs font-mono font-bold tracking-widest text-emerald-400 uppercase mb-3">
        [ CONFÍAN EN NOSOTROS ]
      </h2>
      <h3 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
        {title}
      </h3>
      <p class="mt-3 text-slate-400 text-sm sm:text-base">
        {subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {clients.map((client) => (
        <div class="group flex flex-col p-6 rounded-2xl bg-slate-900/40 border border-slate-800/60 hover:border-emerald-500/40 transition-all duration-300">
          
          <!-- Logo del cliente -->
          <div class="h-12 mb-4 flex items-center">
            <img
              src={client.logo}
              alt={client.name}
              class="h-8 sm:h-10 w-auto opacity-70 grayscale group-hover:opacity-100 group-hover:grayscale-0 transition-all duration-300"
            />
          </div>

          <!-- Nombre del proyecto -->
          <h4 class="text-lg font-bold text-white mb-2">
            {client.project}
          </h4>

          <!-- Problema resuelto -->
          <p class="text-slate-400 text-sm leading-relaxed mb-4 flex-grow">
            {client.problem}
          </p>

          <!-- Tecnologías -->
          {client.tech && (
            <div class="text-xs font-mono text-emerald-400/80 border-t border-slate-800/60 pt-3">
              {client.tech}
            </div>
          )}

        </div>
      ))}
    </div>
  </div>
</section>