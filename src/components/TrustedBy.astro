---
interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = 'Empresas que confían en nosotros',
  subtitle = 'Trabajamos con startups y empresas que necesitan software a medida.',
} = Astro.props;

// Acá está tu cliente real. 
// IMPORTANTE: Si tu archivo es "sn.svg" o "sn.jpg", cambiá la extensión acá abajo.
const clients = [
  { name: 'SN', logo: '/sn.png' }, 
];
---

<section class="py-20 relative z-10 border-y border-slate-800/60 bg-slate-950/40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <h2 class="text-xs font-mono font-bold tracking-widest text-emerald-400 uppercase mb-3">
        [ CONFÍAN EN NOSOTROS ]
      </h2>
      <h3 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
        {title}
      </h3>
      <p class="mt-3 text-slate-400 text-sm sm:text-base">
        {subtitle}
      </p>
    </div>

    <!-- Cambié la grilla para que se centre si hay pocos clientes -->
    <div class="flex flex-wrap justify-center gap-6 items-center">
      {clients.map((client) => (
        <div class="group flex items-center justify-center p-6 rounded-2xl bg-slate-900/40 border border-slate-800/60 hover:border-emerald-500/30 transition-all duration-300 min-w-[150px]">
          <img
            src={client.logo}
            alt={client.name}
            class="h-10 sm:h-12 w-auto opacity-70 grayscale group-hover:opacity-100 group-hover:grayscale-0 transition-all duration-300"
          />
        </div>
      ))}
    </div>
  </div>
</section>